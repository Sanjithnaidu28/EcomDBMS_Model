digraph ERD {
graph [rankdir=LR, splines=polyline, nodesep=0.5, ranksep=1.1, pad=0.3, bgcolor="white", fontname="Helvetica"];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica", fontsize=10, color="#555555", arrowsize=0.9];
CUSTOMER [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>CUSTOMER</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>customer_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">first_name</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">last_name</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"><font color="#333333"><b>UQ</b></font></td><td align="left">email</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"><font color="#333333"><b>UQ</b></font></td><td align="left">phone</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">created_at</td><td align="left"><font color="#777777">DATETIME</font></td></tr></table>>];
ADDRESS [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>ADDRESS</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>address_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">customer_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">address_line</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">city</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">state</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">pincode</td><td align="left"><font color="#777777">CHAR(6)</font></td></tr><tr><td align="left" width="26"></td><td align="left">is_default</td><td align="left"><font color="#777777">BOOLEAN</font></td></tr></table>>];
SELLER [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>SELLER</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>seller_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#333333"><b>UQ</b></font></td><td align="left">store_name</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">contact_name</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"><font color="#333333"><b>UQ</b></font></td><td align="left">email</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">phone</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"><font color="#333333"><b>UQ</b></font></td><td align="left">gstin</td><td align="left"><font color="#777777">CHAR(15)</font></td></tr><tr><td align="left" width="26"></td><td align="left">city</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">joined_on</td><td align="left"><font color="#777777">DATE</font></td></tr></table>>];
CATEGORY [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>CATEGORY</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>category_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#333333"><b>UQ</b></font></td><td align="left">category_name</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">parent_category_id</td><td align="left"><font color="#777777">INT</font></td></tr></table>>];
PRODUCT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>PRODUCT</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>product_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#333333"><b>UQ</b></font></td><td align="left">product_code</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">seller_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">category_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">product_name</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">description</td><td align="left"><font color="#777777">TEXT</font></td></tr><tr><td align="left" width="26"></td><td align="left">unit_price</td><td align="left"><font color="#777777">DECIMAL</font></td></tr><tr><td align="left" width="26"></td><td align="left">return_window_days</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">is_active</td><td align="left"><font color="#777777">BOOLEAN</font></td></tr></table>>];
INVENTORY [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>INVENTORY</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>inventory_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK, UQ</b></font></td><td align="left">product_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">quantity_available</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">reorder_level</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">last_updated</td><td align="left"><font color="#777777">DATETIME</font></td></tr></table>>];
CART [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>CART</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>cart_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK, UQ</b></font></td><td align="left">customer_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">created_at</td><td align="left"><font color="#777777">DATETIME</font></td></tr></table>>];
CART_ITEM [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>CART_ITEM</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>cart_item_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">cart_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">product_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">quantity</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">added_at</td><td align="left"><font color="#777777">DATETIME</font></td></tr></table>>];
ORDERS [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>ORDERS</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>order_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#333333"><b>UQ</b></font></td><td align="left">order_number</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">customer_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">address_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">order_date</td><td align="left"><font color="#777777">DATETIME</font></td></tr><tr><td align="left" width="26"></td><td align="left">order_status</td><td align="left"><font color="#777777">VARCHAR</font></td></tr></table>>];
ORDER_ITEM [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>ORDER_ITEM</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>order_item_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">order_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">product_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">quantity</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">unit_price</td><td align="left"><font color="#777777">DECIMAL</font></td></tr></table>>];
PAYMENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>PAYMENT</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>payment_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK, UQ</b></font></td><td align="left">order_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">amount</td><td align="left"><font color="#777777">DECIMAL</font></td></tr><tr><td align="left" width="26"></td><td align="left">payment_method</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">payment_status</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"><font color="#333333"><b>UQ</b></font></td><td align="left">transaction_ref</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">paid_at</td><td align="left"><font color="#777777">DATETIME</font></td></tr></table>>];
SHIPMENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>SHIPMENT</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>shipment_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK, UQ</b></font></td><td align="left">order_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">courier_name</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"><font color="#333333"><b>UQ</b></font></td><td align="left">tracking_number</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">shipped_date</td><td align="left"><font color="#777777">DATE</font></td></tr><tr><td align="left" width="26"></td><td align="left">expected_delivery</td><td align="left"><font color="#777777">DATE</font></td></tr><tr><td align="left" width="26"></td><td align="left">delivered_date</td><td align="left"><font color="#777777">DATE</font></td></tr><tr><td align="left" width="26"></td><td align="left">shipment_status</td><td align="left"><font color="#777777">VARCHAR</font></td></tr></table>>];
RETURN_REQUEST [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>RETURN_REQUEST</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>return_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">order_item_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">quantity</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">reason</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">request_date</td><td align="left"><font color="#777777">DATE</font></td></tr><tr><td align="left" width="26"></td><td align="left">return_status</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">decided_at</td><td align="left"><font color="#777777">DATETIME</font></td></tr></table>>];
REFUND [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>REFUND</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>refund_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK, UQ</b></font></td><td align="left">return_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">refund_amount</td><td align="left"><font color="#777777">DECIMAL</font></td></tr><tr><td align="left" width="26"></td><td align="left">refund_method</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">refund_status</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">initiated_at</td><td align="left"><font color="#777777">DATETIME</font></td></tr><tr><td align="left" width="26"></td><td align="left">processed_at</td><td align="left"><font color="#777777">DATETIME</font></td></tr></table>>];
REVIEW [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#444444"><tr><td colspan="3" bgcolor="#2E1A47"><font color="white"><b>REVIEW</b></font></td></tr><tr><td align="left" width="26"><font color="#B8860B"><b>PK</b></font></td><td align="left"><b>review_id</b></td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">customer_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"><font color="#2F6F8F"><b>FK</b></font></td><td align="left">product_id</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">rating</td><td align="left"><font color="#777777">INT</font></td></tr><tr><td align="left" width="26"></td><td align="left">comment</td><td align="left"><font color="#777777">VARCHAR</font></td></tr><tr><td align="left" width="26"></td><td align="left">review_date</td><td align="left"><font color="#777777">DATE</font></td></tr></table>>];
CUSTOMER -> ADDRESS [dir=both, arrowtail=teetee, arrowhead=crowtee, label="has"];
CUSTOMER -> CART [dir=both, arrowtail=teetee, arrowhead=teetee, label="owns"];
CART -> CART_ITEM [dir=both, arrowtail=teetee, arrowhead=crowtee, label="contains"];
PRODUCT -> CART_ITEM [dir=both, arrowtail=teetee, arrowhead=crowtee, label="added as"];
CUSTOMER -> ORDERS [dir=both, arrowtail=teetee, arrowhead=crowtee, label="places"];
ADDRESS -> ORDERS [dir=both, arrowtail=teetee, arrowhead=crowtee, label="ships to"];
ORDERS -> ORDER_ITEM [dir=both, arrowtail=teetee, arrowhead=crowtee, label="includes (min 1)"];
PRODUCT -> ORDER_ITEM [dir=both, arrowtail=teetee, arrowhead=crowtee, label="ordered as"];
ORDERS -> PAYMENT [dir=both, arrowtail=teetee, arrowhead=teetee, label="paid by"];
ORDERS -> SHIPMENT [dir=both, arrowtail=teetee, arrowhead=teetee, label="shipped via"];
ORDER_ITEM -> RETURN_REQUEST [dir=both, arrowtail=teetee, arrowhead=crowtee, label="returned via"];
RETURN_REQUEST -> REFUND [dir=both, arrowtail=teetee, arrowhead=teetee, label="settled by"];
SELLER -> PRODUCT [dir=both, arrowtail=teetee, arrowhead=crowtee, label="lists"];
CATEGORY -> PRODUCT [dir=both, arrowtail=teetee, arrowhead=crowtee, label="classifies"];
CATEGORY -> CATEGORY [dir=both, arrowtail=teetee, arrowhead=crowtee, label="parent of"];
PRODUCT -> INVENTORY [dir=both, arrowtail=teetee, arrowhead=teetee, label="stocked in"];
CUSTOMER -> REVIEW [dir=both, arrowtail=teetee, arrowhead=crowtee, label="writes"];
PRODUCT -> REVIEW [dir=both, arrowtail=teetee, arrowhead=crowtee, label="receives"];
}