# Copy the values from your Clever Cloud MySQL add-on's "Informations" tab
# into Render's Environment tab (Dashboard > your service > Environment).
# Do NOT commit a real .env file with real credentials.

DB_HOST=your-addon-host.clever-cloud.com
DB_PORT=3306
DB_USER=your-addon-user
DB_PASSWORD=your-addon-password
DB_NAME=your-addon-database-name
SECRET_KEY=change-me-to-something-random
FLASK_DEBUG=0
